---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import InstagramLink from "../components/InstagramLink.astro";
import CollectionCover from "../components/CollectionCover.astro";
import { loadPhoto } from "../lib/photos";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.sequence - a.data.sequence,
);

const pad = (n: number) => String(n).padStart(2, "0");
// Slugs start with the year, e.g. "2025-svalbard".
const yearOf = (slug: string) => slug.slice(0, 4);
const metaOf = (data: { place?: string; slug: string }) =>
  [data.place, yearOf(data.slug)].filter(Boolean).join(" · ");
// Where a post's photo names are looked up (folder of its post.mdx).
const sourceOf = (post: (typeof posts)[number]) => ({
  dir: post.filePath!.replace(/\/[^/]+$/, ""),
  slug: post.data.slug,
});

// Covers: one of each collection's photos, cropped to a square in CollectionCover.
const covers = await Promise.all(posts.map((post) => loadPhoto(post.data.cover.photo, sourceOf(post))));

// Hero: every visit picks a random collection that has `feature:` photos (equal odds),
// then one of its featured photos. Done in the browser, since the site is static.
const heroes = await Promise.all(
  posts
    .filter((post) => post.data.feature)
    .map((post) => {
      const { slug, title, feature, captions } = post.data;
      const source = sourceOf(post);
      return Promise.all(
        feature!.map(async (name) => {
          const photo = await loadPhoto(name, source);
          return {
            src: photo.src,
            srcset: photo.srcset,
            avifSrcset: photo.avifSrcset ?? "",
            alt: (captions[photo.key] ?? captions[name])?.text ?? `A photo from ${title}`,
            href: `/collections/${slug}`,
            title,
            meta: metaOf(post.data),
          };
        }),
      );
    }),
);
if (heroes.length === 0) {
  throw new Error("Home page hero: set `feature:` (photos from rows) in at least one collection's post.mdx.");
}
// Shown without JavaScript, and as the link text until the pick runs.
const fallback = heroes[0][0];
---

<BaseLayout>
  <section class="relative flex min-h-[520px] items-end overflow-hidden sm:min-h-[640px] lg:min-h-[760px]">
    <!-- No src here: the script below fills in the picked photo, so only that one downloads. -->
    <picture>
      <source id="hero-avif" type="image/avif" sizes="100vw" />
      <img id="hero-img" alt="" sizes="100vw" fetchpriority="high" class="absolute inset-0 size-full object-cover" />
    </picture>
    <noscript>
      <img src={fallback.src} srcset={fallback.srcset} sizes="100vw" alt={fallback.alt} class="absolute inset-0 size-full object-cover" />
    </noscript>
    <div aria-hidden="true" class="hero-fade absolute inset-0"></div>
    <div class="site-container relative flex flex-wrap items-end justify-between gap-6 pb-10 sm:pb-14">
      <h1 class="max-w-[760px] font-display text-[clamp(44px,7vw,96px)] leading-[0.98] font-light tracking-[-0.02em] text-balance text-strong">
        Four years, four latitudes, one camera.
      </h1>
      <a id="hero-link" href={fallback.href} class="flex flex-col gap-1 text-[13px] tracking-[0.06em] text-muted uppercase transition-colors hover:text-strong">
        <span id="hero-title">{fallback.title}</span>
        <span id="hero-meta" class="text-dim">{fallback.meta}</span>
      </a>
    </div>
    <!-- Runs while the page is still loading, so the picked photo is there before anything shows. -->
    <script is:inline define:vars={{ heroes }}>
      const pick = (list) => list[Math.floor(Math.random() * list.length)];
      const hero = pick(pick(heroes));
      const img = document.getElementById("hero-img");
      const avif = document.getElementById("hero-avif");
      if (hero.avifSrcset) avif.srcset = hero.avifSrcset;
      else avif.remove();
      img.alt = hero.alt;
      img.srcset = hero.srcset;
      img.src = hero.src;
      document.getElementById("hero-link").href = hero.href;
      document.getElementById("hero-title").textContent = hero.title;
      document.getElementById("hero-meta").textContent = hero.meta;
    </script>
  </section>

  <section id="collections" class="site-container scroll-mt-4 pt-14 pb-12 sm:pt-[72px]">
    <div class="flex items-baseline justify-between gap-6 border-b border-line pb-5">
      <h2 class="text-[13px] font-medium tracking-[0.08em] text-muted uppercase">Collections</h2>
      <span class="text-[13px] text-dim">{pad(posts.length)}</span>
    </div>

    <ul>
      {posts.map((post, i) => (
        <li>
          <a href={`/collections/${post.data.slug}`} class="collection-row border-b border-line py-5 sm:py-7">
            <span class="num text-[13px] text-dim">{pad(posts.length - i)}</span>
            <span class="title font-display text-[26px] leading-tight font-light tracking-[-0.01em] text-strong sm:text-[40px]">
              {post.data.title}
            </span>
            <span class="meta text-[13px] tracking-[0.04em] text-muted">{metaOf(post.data)}</span>
            <CollectionCover photo={covers[i]} crop={post.data.cover} size={[64, 120]} class="thumb" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="about" class="site-container grid items-start gap-8 pt-6 pb-20 md:grid-cols-2 md:gap-12">
    <p class="max-w-[560px] font-display text-[24px] leading-[1.3] font-light text-pretty text-fg italic sm:text-[28px]">
      "If you cross the glacier, you get to walk on the moon"
    </p>
    <div class="flex flex-col gap-3 text-[15px] leading-relaxed text-muted">
      <p>
        Jan Jelinek travels the world alone with just his backpack and a camera, sharing his experiences online.
      </p>
      <InstagramLink />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-fade {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bg) 15%, transparent) 0%,
      transparent 35%,
      color-mix(in srgb, var(--bg) 92%, transparent) 100%
    );
  }

  .collection-row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 4rem;
    grid-template-areas:
      "num title thumb"
      "num meta  thumb";
    column-gap: 1rem;
    row-gap: 0.25rem;
    align-items: center;
  }
  .num { grid-area: num; }
  .title { grid-area: title; align-self: end; }
  .meta { grid-area: meta; align-self: start; }
  .collection-row :global(.thumb) {
    grid-area: thumb;
    width: 4rem;
    height: 4rem;
    justify-self: end;
    transition: opacity 0.2s;
  }
  .num,
  .meta {
    transition: color 0.2s;
  }
  .collection-row:hover .num,
  .collection-row:hover .meta {
    color: var(--strong);
  }
  .collection-row:hover :global(.thumb) {
    opacity: 0.85;
  }

  @media (width >= 48rem) {
    .collection-row {
      grid-template-columns: 64px minmax(0, 1fr) 160px 120px;
      grid-template-areas: "num title meta thumb";
      column-gap: 2rem;
    }
    .title,
    .meta {
      align-self: center;
    }
    .collection-row :global(.thumb) {
      width: 120px;
      height: 120px;
    }
  }
</style>
