---
import type { CollectionEntry } from 'astro:content';
interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---

<a href={`/collections/${post.data.slug}`} 
   class="shadow-sm box zoom bg-white"
   style={`--color: ${post.data.color}; rotate: ${post.data.rotate}deg;`}>
  <div class="p-[6%]">
    <div class="overlay">
      <img src={post.data.cover.src} alt={`${post.data.title} collection thumbnail image`} />
    </div>
    <div style="font-family: cursive;">
      <div class="flex justify-center w-full pt-2 whitespace-nowrap prop-color">
        {post.data.title}
      </div>
    </div>
    <span class="shadow-xl"></span>
  </div>
</a>

<style>
.prop-color {
  color: var(--color);
}

.overlay {
  position: relative;
  display: inline-block;
}

.overlay::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    25deg,
    var(--color) 0%,
    rgba(0,0,0,0) 26%
  );
}

.zoom {
  transition: transform .12s;
}
.zoom:hover {
  transform: scale(1.12);
  z-index: 3;
  box-shadow: var(--shadow-xl);
}
</style>