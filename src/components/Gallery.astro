---
import GalleryPhoto from "./GalleryPhoto.astro";
import GalleryAside from "./GalleryAside.astro";
import { loadPhoto as loadPhotoFrom } from "../lib/photos";

interface Caption {
  text?: string;
  exposure?: string;
}

/** An image ID, or a list of IDs stacked into one column. */
type RowItem = string | string[];

interface Props {
  slug: string;
  title: string;
  /** Folder holding the post, e.g. "src/collections/2025-peak-fog". */
  dir: string;
  rows: (RowItem[] | { text: string } | { "text-r": string })[];
  captions: Record<string, Caption>;
  /** Asides, keyed by the photo they sit next to: text and/or image file names. */
  commentary: Record<string, string | string[]>;
}

const { slug, title, dir, rows, captions, commentary } = Astro.props;

// Tallest a row's photos get on wide screens, in px.
const MAX_ROW_HEIGHT = 800;
// Space between photos, both within a row and between rows (passed to CSS as --gallery-gap).
const GAP_REM = 0.75;
// Share of the page width a row takes, by how many photos it has (4+ = full width).
const ROW_WIDTH_BY_COUNT = [90, 96, 100];
const rowWidth = (count: number) => ROW_WIDTH_BY_COUNT[count - 1] ?? 100;
// Asides: margin column beside their row on wide screens (px), and the space between them (rem).
// From 1920px wide they hang in the page margin (the row keeps its size); see the CSS below.
const ASIDE_WIDTH = 256;
const ASIDE_GAP_REM = 2;

const pad = (n: number) => String(n).padStart(2, "0");

// Photo names resolve to local preview / R2 / Azure in src/lib/photos.ts.
const loadPhoto = (raw: string) => loadPhotoFrom(raw, { dir, slug });

/** Blank line = new paragraph. A newline, "\n" or <br/> (or a run of them) = line break. */
const splitText = (text: string) =>
  text
    .trim()
    .split(/\n\s*\n/)
    .map((p) => p.split(/(?:\s*(?:<br\s*\/?>|\\n|\n)\s*)+/i));

// In `commentary`, a string with no spaces ending in a photo extension is an image; anything else is text.
const ASIDE_IMAGE = /^\S+\.(jpe?g|png|webp|avif|tiff?)$/i;
const asideFor = (raw: string) => {
  const items = commentary[raw] ?? commentary[raw.replace(/v$/, "")];
  return items === undefined ? undefined : [items].flat().map((s) => s.trim());
};
let asideCount = 0;

async function loadAside(number: string, frame: string, items: string[]) {
  return {
    number,
    frame,
    paragraphs: items.filter((s) => !ASIDE_IMAGE.test(s)).flatMap(splitText),
    // Snapshots, not frames: no download button.
    photos: await Promise.all(
      items.filter((s) => ASIDE_IMAGE.test(s)).map(async (file) => ({ ...(await loadPhoto(file)), download: undefined })),
    ),
  };
}

const round = (n: number) => Number(n.toFixed(5));
/** " - 1.5rem" / " + 1.5rem", so calc() never sees "- -1.5rem". */
const minusRem = (n: number) => (n >= 0 ? ` - ${round(n)}rem` : ` + ${round(-n)}rem`);

/*
 * Row layout. Every column (a photo, or a stack of photos) ends up the same
 * height H, nothing cropped. With row width W, gap g and k columns:
 *   photo of ratio r:          width = r * H
 *   stack of n photos:         acts like one photo of ratio rS = 1 / Σ(1/ri),
 *                              but its n-1 inner gaps add height, so
 *                              width = rS * (H - (n-1)g)
 *   widths + (k-1)g = W   →   H = (W - g(k-1-C)) / R
 * where R = Σ column ratios and C = Σ over stacks of rS(n-1).
 */
let frame = 0;
const blocks = await Promise.all(
  rows.map(async (row) => {
    if (!Array.isArray(row)) {
      const right = "text-r" in row;
      return { kind: "text" as const, right, paragraphs: splitText(right ? row["text-r"] : row.text) };
    }

    // Numbered before the first await, so frames and asides count in reading order.
    const groups = row.map((item) =>
      (Array.isArray(item) ? item : [item]).map((raw) => {
        const items = asideFor(raw);
        return { raw, number: pad(++frame), aside: items && { number: pad(++asideCount), items } };
      }),
    );

    const asides = await Promise.all(
      groups.flat().flatMap(({ number, aside }) => (aside ? [loadAside(aside.number, number, aside.items)] : [])),
    );

    const columns = await Promise.all(
      groups.map(async (group, i) => {
        const photos = await Promise.all(
          group.map(async ({ raw, number, aside }) => {
            const photo = await loadPhoto(raw);
            return { ...photo, number, aside: aside?.number, caption: captions[photo.key] ?? captions[raw] };
          }),
        );
        return {
          photos,
          stacked: Array.isArray(row[i]),
          ratio: 1 / photos.reduce((sum, p) => sum + 1 / p.ratio, 0),
          innerGaps: photos.length - 1,
        };
      }),
    );

    const g = GAP_REM;
    const R = columns.reduce((sum, c) => sum + c.ratio, 0);
    const C = columns.reduce((sum, c) => sum + c.ratio * c.innerGaps, 0);
    const spare = g * (columns.length - 1 - C); // rem taken out of W before sharing it out
    // A stacked column counts as 3 for ROW_WIDTH_BY_COUNT.
    const width = rowWidth(columns.reduce((n, c) => n + (c.stacked ? 3 : 1), 0));

    return {
      kind: "photos" as const,
      asides,
      columns: columns.map((c) => {
        const share = c.ratio / R;
        const vw = `${Math.round(share * width)}vw`;
        // From 1024px an aside row gives up the margin column, so its photos are that much narrower
        // (from 1920px the aside hangs in the page margin instead, and the photos are back to normal).
        const asidePx = Math.round(share * (ASIDE_WIDTH + ASIDE_GAP_REM * 16));
        return {
          ...c,
          basis: `calc((100%${minusRem(spare)}) * ${round(share)}${minusRem(c.ratio * c.innerGaps * g)})`,
          sizes: asides.length
            ? `(min-width: 1920px) ${vw}, (min-width: 1024px) calc(${vw} - ${asidePx}px), (min-width: 640px) ${vw}, 100vw`
            : `(min-width: 640px) ${vw}, 100vw`,
        };
      }),
      // Row width, capped so H never exceeds MAX_ROW_HEIGHT.
      style: `--row-width: ${width}%; --row-max: calc(${Math.round(R * MAX_ROW_HEIGHT)}px${minusRem(-spare)})`,
    };
  }),
);
---

<section id="gallery" aria-label="Photographs" class="site-container flex flex-col py-10 sm:py-12" style={`--gallery-gap: ${GAP_REM}rem; --aside-width: ${ASIDE_WIDTH}px; --aside-gap: ${ASIDE_GAP_REM}rem; gap: var(--gallery-gap)`}>
  {blocks.map((block) =>
    block.kind === "text" ? (
      <div
        class:list={[
          "gallery-text flex max-w-[640px] flex-col gap-4 py-8 sm:py-10 font-display text-[22px] leading-[1.35] font-light text-pretty text-fg sm:text-[26px]",
          block.right && "self-end text-right",
        ]}
      >
        {block.paragraphs.map((lines) => (
          <p>{lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
        ))}
      </div>
    ) : (
      <div class:list={[block.asides.length > 0 && "aside-row"]} style={block.style}>
        <div class="photo-row">
          {block.columns.map((column) =>
            column.stacked ? (
              <div class="photo-stack" style={`--basis: ${column.basis}`}>
                {column.photos.map((photo) => (
                  <GalleryPhoto photo={photo} title={title} sizes={column.sizes} />
                ))}
              </div>
            ) : (
              <GalleryPhoto photo={column.photos[0]} title={title} sizes={column.sizes} style={`--basis: ${column.basis}`} />
            ),
          )}
        </div>
        {block.asides.length > 0 && (
          <div class="aside-col">
            {block.asides.map((aside) => <GalleryAside aside={aside} width={ASIDE_WIDTH} />)}
          </div>
        )}
      </div>
    ),
  )}
</section>

<style>
  .photo-row {
    display: flex;
    flex-direction: column;
    gap: var(--gallery-gap);
    width: 100%;
    margin-inline: auto;
  }
  .photo-stack {
    display: flex;
    flex-direction: column;
    gap: var(--gallery-gap);
    min-width: 0;
  }

  /* Side by side from tablet up, each column at the width worked out above
     (--basis) so every column is the same height without cropping. On phones
     everything stacks full width. */
  @media (width >= 40rem) {
    .photo-row {
      flex-direction: row;
      align-items: flex-start;
      width: var(--row-width);
      max-width: var(--row-max);
    }
    .photo-row > :global(*) {
      flex: 0 0 var(--basis);
    }
  }

  /* A row with asides: under the photos on smaller screens, in a margin column
     beside them from 1024px. The photo row keeps its own width rules relative
     to whatever space is left, so the equal-height math above still holds. */
  .aside-row {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    margin-inline: auto;
    padding-bottom: 1.5rem; /* breathing room before the next row while the aside sits underneath */
  }
  .aside-col {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 560px;
  }
  @media (width >= 40rem) {
    .aside-row {
      width: var(--row-width);
    }
    .aside-row > .photo-row {
      width: 100%;
    }
  }
  @media (width >= 64rem) {
    .aside-row {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--aside-gap);
      max-width: calc(var(--row-max) + var(--aside-width) + var(--aside-gap));
      padding-bottom: 0;
    }
    .aside-row > .photo-row {
      flex: 1 1 0;
      min-width: 0;
      margin: 0;
    }
    .aside-col {
      flex: 0 0 var(--aside-width);
      /* Stays in view while a tall row scrolls past. */
      position: sticky;
      top: 2rem;
    }
  }
  /* Wide screens have room in the page margin (the page is at most 1400px wide):
     the row keeps its normal size and place, and the aside hangs outside it on
     the right. 1920px is where it fits next to a full-width row. */
  @media (width >= 1920px) {
    .aside-row {
      max-width: var(--row-max);
    }
    .aside-row > .photo-row {
      flex: 0 0 100%;
    }
  }
</style>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const options = { zoom: false, loop: false, pswpModule: () => import("photoswipe") };

  // Each aside's snapshots are their own little gallery, separate from the frames.
  new PhotoSwipeLightbox({ gallery: ".aside-gallery", children: "a.aside-item", ...options }).init();

  const lightbox = new PhotoSwipeLightbox({ gallery: "#gallery", children: "a.pswp-item", ...options });

  // Download button: saves the photo's wallpaper JPEG (data-pswp-download). Hidden when a photo has none.
  lightbox.on("uiRegister", () => {
    lightbox.pswp?.ui?.registerElement({
      name: "download",
      order: 9, // just left of the close button
      isButton: true,
      tagName: "a",
      title: "Download wallpaper",
      ariaLabel: "Download wallpaper",
      html: {
        isCustomSVG: true,
        inner:
          '<path d="M16 6v13m-5.5-5.5L16 19l5.5-5.5M8 23.5h16" id="pswp__icn-download" ' +
          'fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
        outlineID: "pswp__icn-download",
      },
      onInit: (el, pswp) => {
        el.setAttribute("download", "");
        el.setAttribute("target", "_blank");
        el.setAttribute("rel", "noopener");
        pswp.on("change", () => {
          const url = (pswp.currSlide?.data.element as HTMLElement | undefined)?.dataset.pswpDownload;
          if (url) (el as HTMLAnchorElement).href = url;
          else el.removeAttribute("href");
          el.style.display = url ? "" : "none";
        });
      },
    });
  });

  lightbox.init();
</script>
