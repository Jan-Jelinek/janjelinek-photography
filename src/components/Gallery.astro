---
import { createHash } from "node:crypto";
import { readFileSync, statSync } from "node:fs";
import { resolve } from "node:path";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import GalleryPhoto from "./GalleryPhoto.astro";
import { publicUrl } from "../lib/images";

interface Caption {
  text?: string;
  exposure?: string;
}

/** An image ID, or a list of IDs stacked into one column. */
type RowItem = string | string[];

interface Props {
  slug: string;
  title: string;
  /** Folder holding the post, e.g. "src/collections/2025-peak-fog". */
  dir: string;
  rows: (RowItem[] | { text: string } | { "text-r": string })[];
  captions: Record<string, Caption>;
}

const { slug, title, dir, rows, captions } = Astro.props;

// Tallest a row's photos get on wide screens, in px.
const MAX_ROW_HEIGHT = 800;
// Space between photos, both within a row and between rows (passed to CSS as --gallery-gap).
const GAP_REM = 0.75;
const WIDTHS = [720, 1200, 1800, 2400];
// Share of the page width a row takes, by how many photos it has (4+ = full width).
const ROW_WIDTH_BY_COUNT = [90, 96, 100];
const rowWidth = (count: number) => ROW_WIDTH_BY_COUNT[count - 1] ?? 100;

const pad = (n: number) => String(n).padStart(2, "0");

interface Photo {
  key: string;
  ratio: number;
  width: number;
  height: number;
  src: string;
  srcset: string;
  /** Same sizes as srcset, as AVIF (uploaded photos only). */
  avifSrcset?: string;
  /** Tiny blurred preview shown while the photo loads. */
  lqip?: string;
  /** Dev only: photo is coming from your PC, not R2. */
  badge?: "not uploaded" | "edited";
  /** Wallpaper JPEG for the lightbox's download button (uploaded photos; local ones in dev). */
  download?: string;
  href: string;
  lightboxSrcset: string;
  lightboxWidth: number;
  lightboxHeight: number;
}

// --- Uploaded: in the collection's photos.json, written by `py r2sync`. ---
interface ManifestEntry {
  sha256: string;
  width: number;
  height: number;
  lqip?: string;
  variants: { edge: number; w: number; h: number; avif: string; webp: string }[];
  download?: { key: string; w: number; h: number };
}
const manifests = import.meta.glob<Record<string, ManifestEntry>>("/src/collections/*/photos.json", {
  eager: true,
  import: "default",
});
const uploaded = manifests[`/${dir}/photos.json`] ?? {};

function r2Photo(file: string, entry: ManifestEntry): Photo {
  const v = entry.variants;
  const fallback = v[Math.min(1, v.length - 1)];
  const largest = v[v.length - 1];
  const webpSrcset = v.map((x) => `${publicUrl(x.webp)} ${x.w}w`).join(", ");
  return {
    key: file,
    ratio: entry.width / entry.height,
    width: fallback.w,
    height: fallback.h,
    src: publicUrl(fallback.webp),
    srcset: webpSrcset,
    avifSrcset: v.map((x) => `${publicUrl(x.avif)} ${x.w}w`).join(", "),
    lqip: entry.lqip,
    download: entry.download && publicUrl(entry.download.key),
    href: publicUrl(largest.webp),
    // The lightbox shows one format, so WebP (works everywhere).
    lightboxSrcset: webpSrcset,
    lightboxWidth: largest.w,
    lightboxHeight: largest.h,
  };
}

// --- Azure: "1-01", or "1-01v" for portrait. ---
// Each photo exists as <id>-720.webp and <id>-1200/1800/2400.jpg (number = long edge).
const azureBase = `https://stjjp.blob.core.windows.net/images/${slug}/`;

function azurePhoto(raw: string): Photo {
  const portrait = raw.endsWith("v");
  const id = portrait ? raw.slice(0, -1) : raw;
  const widthOf = (edge: number) => (portrait ? Math.round((edge * 2) / 3) : edge);
  const url = (edge: number) => `${azureBase}${id}-${edge}.${edge === 720 ? "webp" : "jpg"}`;
  return {
    key: id,
    ratio: portrait ? 2 / 3 : 3 / 2,
    width: widthOf(1200),
    height: portrait ? 1200 : 800,
    src: url(1200),
    srcset: WIDTHS.map((e) => `${url(e)} ${widthOf(e)}w`).join(", "),
    href: url(2400),
    lightboxSrcset: WIDTHS.slice(1).map((e) => `${url(e)} ${widthOf(e)}w`).join(", "),
    lightboxWidth: widthOf(2400),
    lightboxHeight: portrait ? 2400 : 1600,
  };
}

// --- Local preview: "DSCF0669.JPG", a file next to post.mdx. Resized at build time. ---
const LOCAL = /\.(jpe?g|png|webp|avif|tiff?)$/i;
const localFiles = import.meta.glob<{ default: ImageMetadata }>(
  "/src/collections/**/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF,tif,tiff,TIF,TIFF}",
  { eager: true },
);

async function localPhoto(file: string, meta: ImageMetadata, badge: Photo["badge"]): Promise<Photo> {
  const longEdge = Math.max(meta.width, meta.height);
  const widthsFor = (edges: number[]) =>
    edges.filter((e) => e <= longEdge).map((e) => Math.round((e / longEdge) * meta.width));
  const widths = widthsFor(WIDTHS);
  if (widths.length === 0) widths.push(meta.width);

  const heightOf = (w: number) => Math.round((w / meta.width) * meta.height);
  const fallbackWidth = widths[Math.min(1, widths.length - 1)];
  const fullWidth = widths[widths.length - 1];
  // Without `src` override, getImage's default src is a full-resolution copy we don't want.
  const display = await getImage({ src: meta, widths, format: "webp" });
  const fallback = await getImage({ src: meta, width: fallbackWidth, format: "webp" });
  const full = await getImage({ src: meta, width: fullWidth, format: "webp" });
  return {
    key: file,
    ratio: meta.width / meta.height,
    width: fallbackWidth,
    height: heightOf(fallbackWidth),
    src: fallback.src,
    srcset: display.srcSet.attribute,
    href: full.src,
    lightboxSrcset: display.srcSet.attribute,
    lightboxWidth: fullWidth,
    lightboxHeight: heightOf(fullWidth),
    badge: import.meta.env.DEV ? badge : undefined,
    // Dev only, to try the button: in a build this would copy the full original into dist.
    download: import.meta.env.DEV ? meta.src : undefined,
  };
}

// sha256 of a local file, remembered until the file changes (dev re-renders on every reload).
const hashCache = new Map<string, { stamp: string; sha: string }>();
function sha256Of(file: string): string {
  const path = resolve(dir, file);
  const { mtimeMs, size } = statSync(path);
  const stamp = `${mtimeMs}:${size}`;
  const hit = hashCache.get(path);
  if (hit?.stamp === stamp) return hit.sha;
  const sha = createHash("sha256").update(readFileSync(path)).digest("hex");
  hashCache.set(path, { stamp, sha });
  return sha;
}

/*
 * A name with an image extension is a file: your local copy wins (so you can tinker),
 * unless it's identical to the upload; otherwise the uploaded version from photos.json.
 * Local photos are gitignored, so the deployed site only ever uses uploaded ones.
 * A name without an extension is a legacy Azure ID.
 */
async function loadPhoto(raw: string): Promise<Photo> {
  if (!LOCAL.test(raw)) return azurePhoto(raw);
  const local = localFiles[`/${dir}/${raw}`]?.default;
  const entry = uploaded[raw];
  if (local && !(entry && sha256Of(raw) === entry.sha256)) {
    return localPhoto(raw, local, entry ? "edited" : "not uploaded");
  }
  if (entry) return r2Photo(raw, entry);
  const folder = dir.split("/").pop();
  throw new Error(
    `Gallery: "${raw}" is in rows but isn't in ${dir}/ or uploaded. ` +
      `If it's on your PC, run: py r2sync push ${folder}`,
  );
}

const round = (n: number) => Number(n.toFixed(5));
/** " - 1.5rem" / " + 1.5rem", so calc() never sees "- -1.5rem". */
const minusRem = (n: number) => (n >= 0 ? ` - ${round(n)}rem` : ` + ${round(-n)}rem`);

/*
 * Row layout. Every column (a photo, or a stack of photos) ends up the same
 * height H, nothing cropped. With row width W, gap g and k columns:
 *   photo of ratio r:          width = r * H
 *   stack of n photos:         acts like one photo of ratio rS = 1 / Σ(1/ri),
 *                              but its n-1 inner gaps add height, so
 *                              width = rS * (H - (n-1)g)
 *   widths + (k-1)g = W   →   H = (W - g(k-1-C)) / R
 * where R = Σ column ratios and C = Σ over stacks of rS(n-1).
 */
let frame = 0;
const blocks = await Promise.all(
  rows.map(async (row) => {
    if (!Array.isArray(row)) {
      const right = "text-r" in row;
      const text = right ? row["text-r"] : row.text;
      // Blank line = new paragraph. A newline, "\n" or <br/> (or a run of them) = line break.
      const paragraphs = text
        .trim()
        .split(/\n\s*\n/)
        .map((p) => p.split(/(?:\s*(?:<br\s*\/?>|\\n|\n)\s*)+/i));
      return { kind: "text" as const, right, paragraphs };
    }

    // Numbered before the first await, so frames count in reading order.
    const groups = row.map((item) =>
      (Array.isArray(item) ? item : [item]).map((raw) => ({ raw, number: pad(++frame) })),
    );

    const columns = await Promise.all(
      groups.map(async (group, i) => {
        const photos = await Promise.all(
          group.map(async ({ raw, number }) => {
            const photo = await loadPhoto(raw);
            return { ...photo, number, caption: captions[photo.key] ?? captions[raw] };
          }),
        );
        return {
          photos,
          stacked: Array.isArray(row[i]),
          ratio: 1 / photos.reduce((sum, p) => sum + 1 / p.ratio, 0),
          innerGaps: photos.length - 1,
        };
      }),
    );

    const g = GAP_REM;
    const R = columns.reduce((sum, c) => sum + c.ratio, 0);
    const C = columns.reduce((sum, c) => sum + c.ratio * c.innerGaps, 0);
    const spare = g * (columns.length - 1 - C); // rem taken out of W before sharing it out
    // A stacked column counts as 3 for ROW_WIDTH_BY_COUNT.
    const width = rowWidth(columns.reduce((n, c) => n + (c.stacked ? 3 : 1), 0));

    return {
      kind: "photos" as const,
      columns: columns.map((c) => {
        const share = c.ratio / R;
        return {
          ...c,
          basis: `calc((100%${minusRem(spare)}) * ${round(share)}${minusRem(c.ratio * c.innerGaps * g)})`,
          sizes: `(min-width: 640px) ${Math.round(share * width)}vw, 100vw`,
        };
      }),
      // Row width, capped so H never exceeds MAX_ROW_HEIGHT.
      style: `--row-width: ${width}%; --row-max: calc(${Math.round(R * MAX_ROW_HEIGHT)}px${minusRem(-spare)})`,
    };
  }),
);
---

<section id="gallery" aria-label="Photographs" class="site-container flex flex-col py-10 sm:py-12" style={`--gallery-gap: ${GAP_REM}rem; gap: var(--gallery-gap)`}>
  {blocks.map((block) =>
    block.kind === "text" ? (
      <div
        class:list={[
          "gallery-text flex max-w-[640px] flex-col gap-4 py-8 sm:py-10 font-display text-[22px] leading-[1.35] font-light text-pretty text-fg sm:text-[26px]",
          block.right && "self-end text-right",
        ]}
      >
        {block.paragraphs.map((lines) => (
          <p>{lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
        ))}
      </div>
    ) : (
      <div class="photo-row" style={block.style}>
        {block.columns.map((column) =>
          column.stacked ? (
            <div class="photo-stack" style={`--basis: ${column.basis}`}>
              {column.photos.map((photo) => (
                <GalleryPhoto photo={photo} title={title} sizes={column.sizes} />
              ))}
            </div>
          ) : (
            <GalleryPhoto photo={column.photos[0]} title={title} sizes={column.sizes} style={`--basis: ${column.basis}`} />
          ),
        )}
      </div>
    ),
  )}
</section>

<style>
  .photo-row {
    display: flex;
    flex-direction: column;
    gap: var(--gallery-gap);
    width: 100%;
    margin-inline: auto;
  }
  .photo-stack {
    display: flex;
    flex-direction: column;
    gap: var(--gallery-gap);
    min-width: 0;
  }

  /* Side by side from tablet up, each column at the width worked out above
     (--basis) so every column is the same height without cropping. On phones
     everything stacks full width. */
  @media (width >= 40rem) {
    .photo-row {
      flex-direction: row;
      align-items: flex-start;
      width: var(--row-width);
      max-width: var(--row-max);
    }
    .photo-row > :global(*) {
      flex: 0 0 var(--basis);
    }
  }
</style>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#gallery",
    children: "a.pswp-item",
    zoom: false,
    loop: false,
    pswpModule: () => import("photoswipe"),
  });

  // Download button: saves the photo's wallpaper JPEG (data-pswp-download). Hidden when a photo has none.
  lightbox.on("uiRegister", () => {
    lightbox.pswp?.ui?.registerElement({
      name: "download",
      order: 9, // just left of the close button
      isButton: true,
      tagName: "a",
      title: "Download wallpaper",
      ariaLabel: "Download wallpaper",
      html: {
        isCustomSVG: true,
        inner:
          '<path d="M16 6v13m-5.5-5.5L16 19l5.5-5.5M8 23.5h16" id="pswp__icn-download" ' +
          'fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
        outlineID: "pswp__icn-download",
      },
      onInit: (el, pswp) => {
        el.setAttribute("download", "");
        el.setAttribute("target", "_blank");
        el.setAttribute("rel", "noopener");
        pswp.on("change", () => {
          const url = (pswp.currSlide?.data.element as HTMLElement | undefined)?.dataset.pswpDownload;
          if (url) (el as HTMLAnchorElement).href = url;
          else el.removeAttribute("href");
          el.style.display = url ? "" : "none";
        });
      },
    });
  });

  lightbox.init();
</script>
