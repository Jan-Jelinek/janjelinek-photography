---
interface Props {
  photo: {
    number: string;
    caption?: { text?: string; exposure?: string };
    /** Shown at the bottom of the lightbox (e.g. auto exposure). */
    lightboxCaption?: string;
    width: number;
    height: number;
    src: string;
    srcset: string;
    avifSrcset?: string;
    lqip?: string;
    badge?: string;
    download?: string;
    aside?: string;
    href: string;
    lightboxSrcset: string;
    lightboxWidth: number;
    lightboxHeight: number;
  };
  /** Collection title, for fallback alt text. */
  title: string;
  sizes: string;
  style?: string;
}

const { photo, title, sizes, style } = Astro.props;
const { caption } = photo;
---

<figure class="m-0 min-w-0" style={style}>
  <a
    href={photo.href}
    target="_blank"
    class="pswp-item relative block bg-line bg-cover"
    style={photo.lqip ? `background-image: url(${photo.lqip})` : undefined}
    data-pswp-srcset={photo.lightboxSrcset}
    data-pswp-width={photo.lightboxWidth}
    data-pswp-height={photo.lightboxHeight}
    data-pswp-download={photo.download}
    data-pswp-caption={photo.lightboxCaption}
  >
    <picture class="block">
      {photo.avifSrcset && <source type="image/avif" srcset={photo.avifSrcset} sizes={sizes} />}
      <img
        src={photo.src}
        srcset={photo.srcset}
        sizes={sizes}
        width={photo.width}
        height={photo.height}
        alt={caption?.text ?? `${title}, frame ${photo.number}`}
        loading="lazy"
        decoding="async"
        class="block h-auto w-full"
      />
    </picture>
    {photo.badge && (
      <span class="absolute top-2 left-2 rounded-full bg-black/75 px-2.5 py-1 text-[11px] font-medium tracking-[0.06em] text-white uppercase">
        {photo.badge}
      </span>
    )}
    {photo.aside && (
      // Links the photo to its aside ("Aside 01"); the aside itself names the frame for screen readers.
      <span aria-hidden="true" class="absolute top-3 right-3 flex size-7 items-center justify-center rounded-full border border-white/45 bg-black/70 text-[10px] tracking-[0.04em] text-white">
        {photo.aside}
      </span>
    )}
  </a>
  {(caption?.text || caption?.exposure) && (
    <figcaption class="flex justify-between gap-4 pt-3 text-[13px] text-muted">
      <span>{caption.text ? `${photo.number} — ${caption.text}` : photo.number}</span>
      {caption.exposure && <span class="shrink-0 text-dim">{caption.exposure}</span>}
    </figcaption>
  )}
</figure>
