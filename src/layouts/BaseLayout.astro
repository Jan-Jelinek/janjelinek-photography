---
import Head from "../components/Head.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  current?: "home" | "collection" | "about" | "prints";
}

const { title = "Jan Jelinek Photography", current = "home" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
<Head pageTitle={title}>
  <script is:inline>
    try {
      if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light";
    } catch {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300&family=Inter:wght@400;500&display=swap" />
</Head>
<body class="flex min-h-screen flex-col bg-bg font-ui text-fg antialiased transition-colors duration-300">
  <SiteHeader current={current} />
  <main class="flex flex-1 flex-col">
    <slot />
  </main>
  <Footer />
</body>
</html>
