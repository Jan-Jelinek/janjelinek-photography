---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { page } = Astro.props;
---

<!doctype html>
<html lang="en">
<Head pageTitle="Jan Jelinek Photography" />
<body> <!-- style="background-color: #e8e8e8;" -->
  <main>
    <Header page={page} />
    <div class="px-[4%] sm:px-[8%] md:px-[4%] lg:px-[12%] xl:px-[20%]">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </div>
  </main>
  <footer>
    <Footer/>
  </footer>
</body>
</html>

<style>
html, body {
  height: 100%;
}
main {
  min-height: 100%;
  margin-bottom: -100px;
}
main:after {
  content: "";
  display: block;
  height: 100px;
}
footer {
  height: 100px;
  background: #eee;
}
</style>